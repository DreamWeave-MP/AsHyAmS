    {
      "version": "0.2.0",
      "channel": "stable",
      "date": "2026-11-05",
      "status": "available",
      "source": {
        "repository": "https://github.com/DreamWeave-MP/jessql",
        "tag": "jessql-0.2.0",
        "revision": "a359156e95ae60fb693b9af94b13e2da4b1efda6"
      },
      "notes": {
        "summary": "Native JessQL persistence with synchronized WAL commits, immutable generations, recovery verification, and strict-checked JSL.",
        "added": [
          "Synchronized WAL transactions, independently framed group commits, immutable generations, delta flush, and selective compaction.",
          "Managed database create/open-existing lifecycle, offline semantic verification and backup/restore, and versioned observability interfaces.",
          "MIT OR Apache-2.0 licensing, with both license files inside the JPK."
        ],
        "changed": [
          "All shipped JSL modules, tests, benchmarks, and scripts pass --!strict with zero diagnostics.",
          "Package can be activated normally by Jess; no experimental deployment switch or external database process is required."
        ],
        "known_issues": [
          "Managed persistence supports one writer; replication, distributed transactions, and online backups are not implemented.",
          "Physical power-loss guarantees and Windows/macOS durability remain unverified; operational resource thresholds are soft watermarks."
        ]
      },

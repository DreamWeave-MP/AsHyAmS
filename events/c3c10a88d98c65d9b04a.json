    {
      "change": "release-added",
      "version": "1.0.0",
      "channel": "stable",
      "date": "2026-10-21",
      "status": "available",
      "notes": {
        "summary": "S3LightFixes is a Jess package, written in Luau; the Rust program continues on the rust branch at 0.5.0.",
        "breaking": [
          "The tool is the Jess package `org.dreamweave.s3lightfixes`, run through jess rather than as a downloaded binary, so the per-platform downloads, the PortMaster build and the AUR package end with 0.5.0. The Rust program stays on its GitHub releases and this repository's `rust` branch, and is no longer developed on main."
        ]
      }

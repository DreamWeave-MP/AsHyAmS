{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamweave-mp.github.io/AsHyAmS/schemas/dreamweave-network-jess-packages-1.schema.json",
  "title": "DreamWeave Network Jess packages, format version 1",
  "description": "The Jess package claims one DreamWeave Network index observed: every package every enrolled site's jess-packages.json lists, with the site that published it, the feed URL that remains the authority, every version the publisher lists, and id collisions between sites. A discovery cache for Jess clients, not a registry: nothing here was downloaded or verified by the index, and a client reads the publisher's feed before it believes anything.",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "notice",
    "index",
    "observed_at",
    "crawler",
    "packages",
    "conflicts"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "dreamweave-network-jess-packages"
    },
    "format_version": {
      "const": 1
    },
    "notice": {
      "type": "string"
    },
    "index": {
      "$ref": "#/$defs/index"
    },
    "observed_at": {
      "$ref": "#/$defs/optional_time"
    },
    "crawler": {
      "$ref": "#/$defs/optional_string"
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package_claim"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    }
  },
  "$defs": {
    "package_id": {
      "description": "A Jess package id: reverse-DNS, lowercase, as jess.toml's [package] id.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$",
      "maxLength": 200
    },
    "version": {
      "description": "An exact Jess package version: major.minor.patch, no leading zeros.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "requirement": {
      "description": "A Jess version requirement as jess.toml writes one: ^1.2 (or 1.2, the same), =1.2.3.",
      "type": "string",
      "pattern": "^[=^]?(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*)){0,2}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "time": {
      "description": "UTC, second precision: when this index observed something. Never a publisher's date.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "optional_time": {
      "oneOf": [
        {
          "$ref": "#/$defs/time"
        },
        {
          "type": "null"
        }
      ]
    },
    "optional_string": {
      "type": [
        "string",
        "null"
      ]
    },
    "origin_id": {
      "description": "This index's name for a site: readable host and path plus eight hex digits of the site index URL's SHA-256.",
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "index": {
      "type": "object",
      "required": [
        "name",
        "url",
        "repository"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "repository": {
          "$ref": "#/$defs/url"
        }
      }
    },
    "feed_health": {
      "description": "current: the held feed is the one the site serves. Anything else: the held feed is the last good one, and the value says why it is not current.",
      "enum": [
        "current",
        "origin-unavailable",
        "unreachable",
        "invalid",
        "refused",
        "withdrawn"
      ]
    },
    "package_ref": {
      "type": "object",
      "required": [
        "id",
        "origin"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/package_id"
        },
        "origin": {
          "$ref": "#/$defs/origin_id"
        }
      }
    },
    "package_version": {
      "type": "object",
      "required": [
        "version",
        "jess_api",
        "status",
        "content_digest",
        "dependencies",
        "artifact"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "jess_api": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "status": {
          "enum": [
            "available",
            "yanked"
          ]
        },
        "yanked": {
          "description": "Present exactly when status is yanked.",
          "type": "object",
          "required": [
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "replacement": {
              "$ref": "#/$defs/version"
            }
          }
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "content_digest": {
          "description": "The Jess content digest: BLAKE3 over the package's canonical uncompressed content, as jess package inspect prints it and jess.lock pins it. Not a digest of the archive file.",
          "$ref": "#/$defs/hex64"
        },
        "dependencies": {
          "description": "The package's [dependencies], by id. A client checks them against the archive's own manifest.",
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9.-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/requirement"
          }
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "yanked"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "yanked"
            ]
          },
          "else": {
            "not": {
              "required": [
                "yanked"
              ]
            }
          }
        }
      ]
    },
    "artifact": {
      "description": "The JPK archive file: its bytes as served, where to get them, and how to check them.",
      "type": "object",
      "required": [
        "filename",
        "media_type",
        "size",
        "digests",
        "sources",
        "signatures"
      ],
      "additionalProperties": false,
      "properties": {
        "filename": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.jpk$"
        },
        "media_type": {
          "const": "application/vnd.jess.jpk"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "digests": {
          "type": "object",
          "required": [
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "sha256": {
              "description": "SHA-256 of the archive file's bytes as downloaded.",
              "$ref": "#/$defs/hex64"
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "url",
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "url": {
                "$ref": "#/$defs/url"
              },
              "kind": {
                "enum": [
                  "publisher",
                  "mirror"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "signatures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "format",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "format": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "$ref": "#/$defs/url"
              },
              "issuer": {
                "type": "string",
                "minLength": 1
              },
              "identity": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "package_claim": {
      "type": "object",
      "required": [
        "id",
        "origin",
        "publisher",
        "summary",
        "project",
        "repository",
        "feed_url",
        "feed_sha256",
        "health",
        "cached",
        "problem",
        "first_observed",
        "last_changed",
        "last_attempt",
        "last_success",
        "current",
        "versions",
        "conflict",
        "network_page"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/package_id"
        },
        "origin": {
          "$ref": "#/$defs/origin_id"
        },
        "publisher": {
          "type": "object",
          "required": [
            "name",
            "url"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "url": {
              "$ref": "#/$defs/url"
            }
          }
        },
        "summary": {
          "$ref": "#/$defs/optional_string"
        },
        "project": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "repository": {
          "$ref": "#/$defs/optional_string"
        },
        "feed_url": {
          "description": "The publisher's jess-packages.json: the authority for every version below.",
          "$ref": "#/$defs/url"
        },
        "feed_sha256": {
          "description": "The digest of the feed this index holds and copied these versions from.",
          "$ref": "#/$defs/hex64"
        },
        "health": {
          "$ref": "#/$defs/feed_health"
        },
        "cached": {
          "type": "boolean"
        },
        "problem": {
          "$ref": "#/$defs/optional_string"
        },
        "first_observed": {
          "$ref": "#/$defs/time"
        },
        "last_changed": {
          "$ref": "#/$defs/optional_time"
        },
        "last_attempt": {
          "$ref": "#/$defs/time"
        },
        "last_success": {
          "$ref": "#/$defs/optional_time"
        },
        "current": {
          "description": "The newest version the publisher offers for new installs, or null when every version is yanked.",
          "oneOf": [
            {
              "$ref": "#/$defs/version"
            },
            {
              "type": "null"
            }
          ]
        },
        "versions": {
          "description": "Every version the feed lists, newest first, yanked ones included, copied unchanged.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/package_version"
          }
        },
        "conflict": {
          "type": "boolean"
        },
        "network_page": {
          "$ref": "#/$defs/url"
        }
      }
    },
    "conflict": {
      "type": "object",
      "required": [
        "id",
        "claims",
        "shared_versions",
        "same_bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/package_id"
        },
        "claims": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/package_ref"
          }
        },
        "shared_versions": {
          "description": "Versions more than one of the claims lists.",
          "type": "integer",
          "minimum": 0
        },
        "same_bytes": {
          "description": "Every shared version names the same content digest and archive digest in every claim: the sites mirror one publication. False when any differs, or when no version is shared.",
          "type": "boolean"
        }
      }
    }
  }
}
